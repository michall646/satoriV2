{
  "name": "satori-v2",
  "version": "2.0.0",
  "private": true,
  "description": "Satori V2 — API-first online judge + contest/course hosting (UZI, Playground, Labs). Modern rewrite, Kolejka-native.",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/cli",
    "packages/sdk",
    "packages/judge"
  ],
  "scripts": {
    "demo": "node scripts/demo.js",
    "dev:api": "node apps/api/src/server.js",
    "dev:web": "npm --prefix apps/web dev",
    "clean:web": "node -e \"require('fs').rmSync('apps/web/.next',{recursive:true,force:true})\"",
    "seed": "node apps/api/src/seed.js",
    "migrate:v2": "node scripts/migrate-v2.js",
    "test": "node --test tests/*.test.js",
    "cli": "node apps/cli/bin/satori.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
